FROM python:3.14-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app/research_sandbox
ENV STAR_RESEARCH_PERSISTENT_ROOT=/var/data/star-research
ENV RESEARCH_BRAIN_ENABLED=false
ENV RESEARCH_BRAIN_KILL_SWITCH=true
ENV RESEARCH_BRAIN_WAKE_INTERVAL_SECONDS=14400
ENV OMP_NUM_THREADS=1
ENV OPENBLAS_NUM_THREADS=1
ENV MKL_NUM_THREADS=1
ENV NUMEXPR_NUM_THREADS=1

WORKDIR /app

COPY research_sandbox/*.py ./research_sandbox/

CMD ["python", "-m", "cloud_service"]
