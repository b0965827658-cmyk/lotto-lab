FROM python:3.14-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app/research_sandbox
ENV STAR_RESEARCH_PERSISTENT_ROOT=/var/data/star-research
ENV RESEARCH_BRAIN_ENABLED=false
ENV RESEARCH_BRAIN_KILL_SWITCH=true
ENV RESEARCH_BRAIN_WAKE_INTERVAL_SECONDS=14400
ENV PORT=10000
ENV OMP_NUM_THREADS=1
ENV OPENBLAS_NUM_THREADS=1
ENV MKL_NUM_THREADS=1
ENV NUMEXPR_NUM_THREADS=1

WORKDIR /app

COPY research_sandbox/*.py ./research_sandbox/
COPY research_sandbox/approved_inputs.json /app/research_fixture/approved_inputs.json
COPY TW539_top15_failure_audit/hit_distribution.csv /app/research_fixture/TW539_top15_failure_audit/hit_distribution.csv
COPY TW539_top15_failure_audit/random_theoretical_distribution.json /app/research_fixture/TW539_top15_failure_audit/random_theoretical_distribution.json
COPY TW539_top15_failure_audit/ranking_concentration.json /app/research_fixture/TW539_top15_failure_audit/ranking_concentration.json

EXPOSE 10000

CMD ["python", "-m", "cloud_service"]
