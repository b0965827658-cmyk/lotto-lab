{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tw539-evidence-v1.0.0",
  "title": "TW539 Live Evidence Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","lottery","draw_id","subject_type","subject_version","prediction_hash","prediction_created_at","locked_at","actual_available_at","actual","top5","top10","top15","hits_top5","hits_top10","hits_top15","win_tie_lose","validity_status","invalid_reason","settled_at","runtime_version","dataset_version","dataset_sha256","record_sha256"],
  "properties": {
    "schema_version": {"const": "tw539-evidence-v1.0.0"},
    "lottery": {"const": "tw539"},
    "draw_id": {"type": "string", "minLength": 1},
    "subject_type": {"enum": ["current", "baseline", "candidate"]},
    "subject_version": {"type": "string", "minLength": 1},
    "prediction_hash": {"type": "string"},
    "prediction_created_at": {"type": "string", "format": "date-time"},
    "locked_at": {"type": "string", "format": "date-time"},
    "actual_available_at": {"type": "string", "format": "date-time"},
    "actual": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "integer", "minimum": 1, "maximum": 39}, "uniqueItems": true},
    "top5": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "integer"}, "uniqueItems": true},
    "top10": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"type": "integer"}, "uniqueItems": true},
    "top15": {"type": "array", "minItems": 15, "maxItems": 15, "items": {"type": "integer"}, "uniqueItems": true},
    "hits_top5": {"type": ["integer", "null"]},
    "hits_top10": {"type": ["integer", "null"]},
    "hits_top15": {"type": ["integer", "null"]},
    "win_tie_lose": {"enum": ["win", "tie", "loss", null]},
    "validity_status": {"enum": ["valid", "invalid"]},
    "invalid_reason": {"type": ["string", "null"]},
    "settled_at": {"type": "string", "format": "date-time"},
    "runtime_version": {"const": "tw539-evidence-runtime-v1.0.0"},
    "dataset_version": {"type": ["string", "null"]},
    "dataset_sha256": {"type": ["string", "null"]},
    "record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "unique_key": "lottery|draw_id|subject_version|schema_version"
}
